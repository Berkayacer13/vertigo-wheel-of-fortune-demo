# ==============================================================
# Unity 2021 LTS .gitignore
# Keep: Assets/, Packages/, ProjectSettings/. Ignore generated.
# ==============================================================

# Generated by the editor / build
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated IDE/project files
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*
.vs/
.vsconfig
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Internal planning/guide docs — kept locally, not tracked in the repo
/docs/**/*.md

# OS / misc
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# DOTween generated settings (regenerated per machine on import)
/[Aa]ssets/[Rr]esources/DOTweenSettings.asset*

# Stray Unity 6 project accidentally created inside the repo (not part of the demo)
/Vertigo Demo/
